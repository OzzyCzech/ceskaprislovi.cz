---
const { text } = Astro.props as { text: string };
const prompt = `Vysvětli česky význam tohoto přísloví nebo rčení: „${text}“ Pokud obsahuje starší či nářeční výrazy, objasni je. Pokud si výkladem nejsi jistý, uveď to.`;
const query = encodeURIComponent(prompt);
const link = 'font-semibold text-ink underline underline-offset-4 hover:text-rust';
---
<div data-ai-prompt={prompt}>
  <h2 class="kicker text-rust">Význam</h2>
  <p class="mx-auto mt-3 max-w-[62ch] rounded-2xl border-2 border-dashed border-line bg-paper px-6 py-5 text-muted italic">
  Význam přísloví zatím chybí, ale můžete se zeptat
  <a class={link} href={`https://chatgpt.com/?q=${query}`} target="_blank" rel="noopener noreferrer">ChatGPT</a>,
  <a class={link} href={`https://claude.ai/new?q=${query}`} target="_blank" rel="noopener noreferrer">Claude</a>
  nebo <a class={link} href="https://gemini.google.com/app" target="_blank" rel="noopener noreferrer" data-copy-ai-prompt>Gemini</a>.
  U Gemini vám otázku zkopírujeme do schránky.
  </p>
</div>

<script>
  import { announce } from '../lib/actions';

  const box = document.querySelector<HTMLElement>('[data-ai-prompt]');
  const prompt = box?.dataset.aiPrompt;
  const copyError = 'Otázku se nepodařilo zkopírovat. Zadejte ji přímo v Gemini.';
  box?.querySelector('[data-copy-ai-prompt]')?.addEventListener('click', () => {
    if (!prompt) return;
    if (!navigator.clipboard) {
      announce(copyError);
      return;
    }
    void navigator.clipboard.writeText(prompt)
      .then(() => announce('Otázka je ve schránce. Vložte ji do chatu.'))
      .catch(() => announce(copyError));
  });
</script>
