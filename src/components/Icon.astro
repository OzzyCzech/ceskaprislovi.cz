---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Copy from '@lucide/astro/icons/copy';
import Download from '@lucide/astro/icons/download';
import Flag from '@lucide/astro/icons/flag';
import Link2 from '@lucide/astro/icons/link-2';
import Search from '@lucide/astro/icons/search';
import Share from '@lucide/astro/icons/share';
import Shuffle from '@lucide/astro/icons/shuffle';

const icons = {
  search: Search,
  next: ArrowRight,
  previous: ArrowLeft,
  random: Shuffle,
  download: Download,
  share: Share,
  link: Link2,
  copy: Copy,
  flag: Flag,
};
interface Props {
  name: keyof typeof icons;
  size?: number;
}
const { name, size = 18 } = Astro.props;
const Glyph = icons[name];
---
<Glyph aria-hidden="true" size={size} strokeWidth={1.75} class="shrink-0" />
