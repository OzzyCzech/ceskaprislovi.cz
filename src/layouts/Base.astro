---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { proverbs } from '../lib/proverbs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Page-specific Open Graph image (1200×630); defaults to the site preview. */
  image?: { url: string; alt: string };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = 'Česká přísloví a pořekadla. Hledejte podle slov či témat a sdílejte svá oblíbená přísloví.', noindex, image, jsonLd } = Astro.props;
const pageTitle = title ? `${title} | Česká přísloví` : 'Česká přísloví a pořekadla';
const pathname = Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(pathname === '/index' ? '/' : pathname, Astro.site);
const socialImage = new URL(image?.url ?? '/social-preview.png', Astro.site);
const socialImageAlt = image?.alt ?? 'Česká přísloví a pořekadla na ceskaprislovi.cz';
const total = new Intl.NumberFormat('cs-CZ').format(proverbs.length);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="author" href="/humans.txt" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f7" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Česká přísloví" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title ?? 'Česká přísloví a pořekadla'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />}
  </head>
  <body class="flex flex-col bg-paper font-sans text-ink antialiased">
    <a href="#obsah" class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:bg-paper focus:p-3">Přeskočit na obsah</a>
    <header class="border-b border-line">
      <div class="frame flex flex-wrap items-center justify-between gap-x-5 gap-y-3 py-4 sm:min-h-[5.4rem]">
        <a href="/" class="flex items-center gap-3 text-xl font-black tracking-[-.045em]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="22" height="22" aria-hidden="true" class="shrink-0"><path fill="#f54a00" d="M13 49h32v20c0 17-12 27-32 31V86c9-3 13-7 14-13H13zm44 0h32v20c0 17-12 27-32 31V86c9-3 13-7 14-13H57z" /></svg>
          Česká přísloví
        </a>
        <nav aria-label="Hlavní navigace" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-bold sm:gap-x-7 sm:text-base">
          <a href="/teta-katerina" class="hover:text-rust">Teta Kateřina</a>
          <a href="/temata" class="hover:text-rust">Témata</a>
          <a href="/#abeceda" class="hover:text-rust">Abecedně</a>
          <a href="/?nahodne=1" data-random="detail" class="hover:text-rust">Náhodné přísloví</a>
          <a href="/#hledat" aria-label="Hledat" class="button min-h-10 px-2.5 sm:min-h-11 sm:px-3"><Icon name="search" /></a>
        </nav>
      </div>
    </header>
    <main id="obsah" tabindex="-1" class="flex-1"><slot /></main>
    <footer class="mt-14 border-t border-line bg-white py-10 sm:mt-24 sm:py-14">
      <div class="frame grid gap-10 sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)] sm:gap-8">
        <div>
          <a href="/" class="text-lg font-black tracking-tight">Česká přísloví<span class="text-rust">.</span></a>
          <p class="mt-2 max-w-[28ch] text-base font-semibold leading-snug">Lidová moudrost, živá i dávno zapomenutá.</p>
          <p class="mt-3 text-sm text-muted">{total} přísloví a pořekadel, každý den jedno na úvod.</p>
        </div>
        <nav aria-label="Patička" class="text-sm">
          <ul class="space-y-2 font-bold">
            <li><a href="/temata" class="hover:text-rust">Témata</a></li>
            <li><a href="/#abeceda" class="hover:text-rust">Abecedně</a></li>
            <li><a href="/?nahodne=1" data-random="detail" class="hover:text-rust">Náhodné přísloví</a></li>
            <li><a href="/teta-katerina" class="hover:text-rust">Teta Kateřina</a></li>
          </ul>
        </nav>
        <div class="text-sm">
          <ul class="space-y-2 font-bold">
            <li><a href="/o-projektu" class="hover:text-rust">O projektu</a></li>
            <li><a href="/co-je-prislovi" class="hover:text-rust">Co je přísloví</a></li>
            <li><a href="https://bsky.app/profile/ceskaprislovi.cz" rel="me" class="hover:text-rust">Sledujte na Bluesky</a></li>
            <li><a href="https://ozana.cz" class="hover:text-rust">Vytvořil Roman Ožana</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <p id="site-status" class="site-status empty:sr-only" role="status"></p>
    <script>
      import '../lib/browse';
      import '../lib/actions';
    </script>
  </body>
</html>
