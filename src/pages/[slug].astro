---
import type { GetStaticPaths } from 'astro';
import { themePath } from '../lib/theme-path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProverbCard from '../components/ProverbCard.astro';
import { dailyProverbs, proverbs, proverbsByTheme, type Proverb } from '../lib/proverbs';

export const getStaticPaths = (() => proverbs.map((proverb, index) => ({
  params: { slug: proverb.slug },
  props: {
    proverb,
    previous: proverbs[(index - 1 + proverbs.length) % proverbs.length].slug,
    next: proverbs[(index + 1) % proverbs.length].slug,
    original: proverb.variantOf ? proverbs.find(({ text }) => text === proverb.variantOf) : undefined,
  },
}))) satisfies GetStaticPaths;

const { proverb, previous, next, original } = Astro.props as {
  proverb: Proverb;
  previous: string;
  next: string;
  original?: Proverb;
};
const theme = proverb.tags[0];
const sameTheme = (theme ? proverbsByTheme.get(theme) ?? [] : []).filter((entry) => entry.slug !== proverb.slug);
const related = [...sameTheme.slice(0, 3), ...dailyProverbs.filter((entry) => entry.slug !== proverb.slug)].slice(0, 3);
const titleSize = proverb.text.length <= 70
  ? 'text-[clamp(3rem,9.7vw,8.75rem)]'
  : 'text-[clamp(2.5rem,6.2vw,6rem)]';
const description = proverb.meaning
  ? `${proverb.text} ${proverb.meaning}`
  : `České přísloví „${proverb.text}“${proverb.tags.length ? ` Témata: ${proverb.tags.join(', ')}.` : ''}`;
const site = Astro.site?.origin ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sbírka', item: `${site}/` },
    ...(theme ? [{ '@type': 'ListItem', position: 2, name: theme, item: `${site}${themePath(theme)}` }] : []),
    { '@type': 'ListItem', position: theme ? 3 : 2, name: proverb.text, item: `${site}/${proverb.slug}` },
  ],
};
---
<Base title={proverb.text} description={description} jsonLd={jsonLd}>
  <div class="frame pt-7 sm:pt-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <nav aria-label="Drobečková navigace" class="text-sm text-muted sm:text-base">
        <ol class="flex items-center gap-2">
          <li><a href="/?sbirka=1#vysledky" class="underline underline-offset-4 hover:text-rust">Sbírka</a></li>
          {theme && <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="underline underline-offset-4 hover:text-rust" href={themePath(theme)}>{theme}</a></li>}
        </ol>
      </nav>
      <nav aria-label="Listování sbírkou" class="flex flex-wrap gap-2">
        <a class="button" href={`/${previous}`} rel="prev"><Icon name="previous" size={16} /> Předchozí</a>
        <a class="button" href={`/${next}`} rel="next">Další <Icon name="next" size={16} /></a>
      </nav>
    </div>

    <article data-proverb={proverb.text} data-slug={proverb.slug}>
      <h1 class:list={['display pt-12 pb-10 sm:pt-20 sm:pb-14', titleSize]}>
        {proverb.text.endsWith('.') ? <>{proverb.text.slice(0, -1)}<span class="display-dot">.</span></> : proverb.text}
      </h1>

      <div class="grid items-start gap-10 border-t-2 border-ink pt-7 sm:pt-8 lg:grid-cols-[minmax(0,1fr)_21.25rem] lg:gap-16">
        <div class="space-y-8 sm:space-y-10">
        {proverb.meaning && (
          <div class="max-w-[62ch]">
            <h2 class="kicker text-rust">Význam</h2>
            <p class="mt-3 text-xl leading-snug font-medium tracking-[-.01em] sm:text-[1.6rem]">{proverb.meaning}</p>
          </div>
        )}
        <dl class="grid grid-cols-[5rem_minmax(0,1fr)] items-baseline gap-x-4 gap-y-5 sm:grid-cols-[8rem_minmax(0,1fr)]">
          {proverb.tags.length > 0 && (
            <>
              <dt class="kicker text-muted">Témata</dt>
              <dd><ul class="flex flex-wrap gap-2">
                {proverb.tags.map((tag) => <li><a class="theme-chip" href={themePath(tag)}>{tag}</a></li>)}
              </ul></dd>
            </>
          )}
          {Boolean(proverb.alternatives?.length) && (
            <>
              <dt class="kicker text-muted">Jiné znění</dt>
              <dd><ul class="space-y-1 text-muted">
                {proverb.alternatives?.map((text) => <li>{text}</li>)}
              </ul></dd>
            </>
          )}
          {original && (
            <>
              <dt class="kicker text-muted">Starší znění</dt>
              <dd><a href={`/${original.slug}`} class="font-semibold underline underline-offset-4 hover:text-rust">{original.text}</a></dd>
            </>
          )}
        </dl>
        </div>

        <aside aria-label="Akce k přísloví" class="w-full max-w-[24rem] lg:max-w-none">
          <div class="space-y-5" data-actions>
            <div role="group" aria-labelledby="copy-heading">
              <h2 id="copy-heading" class="kicker text-muted">Text a odkaz</h2>
              <div class="mt-3 grid gap-2">
                <button type="button" class="button button-primary" data-action="copy"><Icon name="copy" size={16} /> <span data-label>Kopírovat přísloví</span></button>
                <button type="button" class="button" data-action="link"><Icon name="link" size={16} /> <span data-label>Kopírovat odkaz</span></button>
              </div>
            </div>
            <div role="group" aria-labelledby="share-heading">
              <h2 id="share-heading" class="kicker text-muted">Sdílet jako obrázek</h2>
              <div class="mt-3 grid gap-2 min-[380px]:grid-cols-2">
                <button type="button" class="button" data-action="share"><Icon name="share" size={16} /> Sdílet</button>
                <button type="button" class="button" data-action="download"><Icon name="download" size={16} /> Stáhnout PNG</button>
              </div>
            </div>
          </div>
          <noscript><p class="mt-3 text-sm text-muted">Pro kopírování a vytvoření obrázku zapněte JavaScript.</p></noscript>
        </aside>
      </div>
    </article>

    <section class="mt-14 sm:mt-24 lg:mt-28" aria-labelledby="related-heading">
      <h2 id="related-heading" class="section-title mb-5">{theme ? `Další na téma ${theme}` : 'Další ze sbírky'}</h2>
      <div class="border-t border-line">{related.map((entry) => <ProverbCard proverb={entry} />)}</div>
    </section>
  </div>
</Base>
